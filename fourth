import numpy as np 
import matplotlib.pyplot as plt 
d = np.arange(1,101,1) 
c=3 * pow(10,8) 
f1=800* pow(10,6) 
f2=950* pow(10,6) 
f3=650* pow(10,6) 
pl1= 20*np.log10(4*np.pi/c) + 20 * np.log10(f1) + 20* np.log10(d) 
pl2= 20*np.log10(4*np.pi/c) + 20 * np.log10(f2) + 20* np.log10(d) 
pl3= 20*np.log10(4*np.pi/c) + 20 * np.log10(f3) + 20* np.log10(d) 
plt.plot(d,pl1, label="800MHz") 
plt.plot(d,pl2, label="950MHz") 
plt.plot(d,pl3, label="650MHz") 
plt.title("Path Loss vs Distance") 
plt.xlabel("Distance") 
plt.ylabel("Path loss") 
plt.grid() 
plt.legend() 
plt.show() 
